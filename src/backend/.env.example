# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# Database Connection String (MySQL)
CONNECTION_STRING=Server=localhost;Port=3306;Database=csharpacademy;Uid=root;Pwd=YOUR_PASSWORD;CharSet=utf8mb4;

# Google Gemini for AI Learning Assistant and quiz generation (falls back to offline if unset)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# JWT Configuration
JWT_KEY=YOUR_SECRET_KEY_HERE_MINIMUM_32_CHARACTERS
JWT_ISSUER=CsharpAcademy
JWT_AUDIENCE=CsharpAcademy
JWT_EXPIRE_MINUTES=1440

# Email Configuration (Gmail SMTP)
# To use Gmail SMTP:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Use the App Password (not your regular password) in SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=noreply@csharpacademy.com
SMTP_FROM_NAME=C# Academy

